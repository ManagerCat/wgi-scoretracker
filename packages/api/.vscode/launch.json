{
  "configurations": [
    {
      "name": "Cloud Run: Run/Debug Locally",
      "type": "cloudcode.cloudrun",
      "request": "launch",
      "build": {
        "docker": {
          "path": "Dockerfile"
        }
      },
      "image": "api",
      "service": {
        "name": "api",
        "containerPort": 8080,
        "env": [
          {
            "name": "GOOGLE_CLOUD_PROJECT",
            "value": "wgiscoreapp"
          },
          {
            "name": "GCLOUD_PROJECT",
            "value": "wgiscoreapp"
          },
          {
            "name": "GOOGLE_APPLICATION_CREDENTIALS",
            "value": "/app/wgiscoreapp-c0f8f08ebe54.json"
          }
        ],
        "resources": {
          "limits": {
            "memory": "256Mi"
          }
        }
      },
      "target": {
        "minikube": {}
      },
      "watch": true
    }
  ]
}
